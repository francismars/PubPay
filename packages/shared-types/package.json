{
  "name": "@pubpay/shared-types",
  "version": "1.0.0",
  "description": "Shared TypeScript types for PubPay",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
