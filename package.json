{
  "name": "pubpay",
  "version": "0.0.0",
  "private": true,
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "start:backend": "pnpm --filter @pubpay/backend start",
    "dev": "pnpm --filter @pubpay/pubpay dev",
    "dev:pubpay": "pnpm --filter @pubpay/pubpay dev",
    "dev:live": "pnpm --filter @pubpay/live dev",
    "dev:jukebox": "pnpm --filter @pubpay/jukebox dev",
    "dev:backend": "pnpm --filter @pubpay/backend dev",
    "dev:all": "concurrently \"pnpm dev:backend\" \"pnpm dev:pubpay\" \"pnpm dev:live\" \"pnpm dev:jukebox\"",
    "dev:apps": "concurrently \"pnpm dev:pubpay\" \"pnpm dev:live\" \"pnpm dev:jukebox\"",
    "dev:full": "concurrently \"pnpm dev:backend\" \"pnpm dev:pubpay\" \"pnpm dev:live\" \"pnpm dev:jukebox\"",
    "build": "pnpm -r build",
    "build:prod": "NODE_ENV=production pnpm -r build",
    "build:pubpay": "pnpm --filter @pubpay/pubpay build",
    "build:live": "pnpm --filter @pubpay/live build",
    "build:jukebox": "pnpm --filter @pubpay/jukebox build",
    "build:backend": "pnpm --filter @pubpay/backend build",
    "type-check": "pnpm -r type-check",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,scss,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,scss,md}\"",
    "clean": "rimraf dist",
    "knip": "knip",
    "knip:fix": "knip --fix",
    "prepare": "husky",
    "precommit": "lint-staged"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "buffer": "^6.0.3",
    "concurrently": "^9.2.1",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.5",
    "eslint": "^10.13.0",
    "html-webpack-plugin": "^5.6.8",
    "husky": "^9.1.7",
    "knip": "^5.73.0",
    "lint-staged": "^17.6.0",
    "mini-css-extract-plugin": "^2.10.2",
    "prettier": "^3.9.10",
    "process": "^0.11.10",
    "rimraf": "^6.1.3",
    "stream-browserify": "^3.0.0",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.6.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.1.0"
  },
  "lint-staged": {
    "apps/**/*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "packages/**/*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "tools/**/*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "scripts/**/*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "apps/**/*.{json,css,scss,md}": [
      "prettier --write"
    ],
    "packages/**/*.{json,css,scss,md}": [
      "prettier --write"
    ],
    "tools/**/*.{json,css,scss,md}": [
      "prettier --write"
    ],
    "scripts/**/*.{json,css,scss,md}": [
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@12.15.0",
  "dependencies": {},
  "engines": {
    "node": ">=24"
  }
}
